# ─────────────────────────────────────────────────────────────
# UDoc Backend — Variáveis de Ambiente
# Copie para .env e preencha os valores antes de subir o container
# ─────────────────────────────────────────────────────────────

# Banco de dados PostgreSQL
# Formato Neon:  jdbc:postgresql://ep-xxx.neon.tech/neondb?sslmode=require
# Formato local: jdbc:postgresql://localhost:5432/udoc
DATABASE_URL=jdbc:postgresql://localhost:5432/udoc
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=senha_segura

# Porta do servidor (Koyeb injeta automaticamente; em VPS use 8080 ou 80)
PORT=8081

# CORS — URL exata do frontend (sem barra no final)
CORS_ORIGIN=https://seu-app.vercel.app

# JWT — gere uma chave aleatória forte (mínimo 64 caracteres)
JWT_SECRET=troque-por-uma-chave-aleatoria-longa-e-segura-com-pelo-menos-64-caracteres!!
JWT_EXPIRATION_MS=86400000

# URL pública do frontend (usada nos links de e-mail)
APP_FRONTEND_URL=https://seu-app.vercel.app

# E-mail via SendGrid (opcional — necessário para reset de senha e convites)
SENDGRID_API_KEY=SG.xxxxxx
MAIL_FROM_ADDRESS=noreply@suaempresa.com

# IA Groq (opcional — pode deixar vazio se usar outra IA)
AI_KEY=gsk_xxxxxx

# Ollama — URL do serviço local de IA (Llama, Qwen).
# Docker Compose com --profile ollama: http://ollama:11434/v1/chat/completions (padrão)
# Instalação local sem Docker:         http://localhost:11434/v1/chat/completions
# Deixe em branco se não usar IA local.
AI_OLLAMA_URL=http://ollama:11434/v1/chat/completions

# Chave de criptografia AES-256 (exatamente 32 caracteres)
ENCRYPTION_KEY=Troque_Por_32_Chars_Exatos_Aqui!
